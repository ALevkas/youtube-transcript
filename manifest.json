{
  "manifest_version": 3,
  "name": "YouTube Transcript to LLM",
  "version": "1.0.0",
  "description": "Send YouTube video transcripts to ChatGPT, Claude, or Gemini for analysis",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content/content.js"]
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/llm-injector.js"]
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  }
}
